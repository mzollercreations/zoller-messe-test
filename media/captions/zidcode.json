{"en":[[1.5,3.81,"Every tool is measured to the micron."],[4.91,6.74,"And then, someone types it in."],[9.14,10.99,"Two digits. Swapped."],[11.99,13.37,"That's all it takes."],[15.27,17.25,"Or let the tool speak for itself."],[21.47,24.18,"Up to seventeen values. One scan."],[30.31,31.63,"Meet »zidCode«."],[32.13,34.92,"Tool identification, right at the machine."],[37.4,39.02,"Measured at the presetter."],[39.47,40.92,"Scanned at the machine."],[41.37,43.26,"Written straight into the control."],[46.35,47.86,"Nearly half the time."],[50.06,51.77,"And not a single typo."],[55.41,57.14,"Whatever control you run."],[62.33,64.36,"When the job is done, scan it out."],[64.91,67.48,"Its tool life goes straight back into the cloud."],[67.83,69.29,"Always up to date."],[77.35,79.87,"»zidCode«. Every digit in its place."],[82.65,84.79,"ZOLLER. Expect great measures."]],"de":[[1.5,3.81,"Jedes Werkzeug wird auf den Mikrometer genau gemessen."],[4.91,6.74,"Und dann tippt es jemand ab."],[9.14,10.99,"Zwei Ziffern. Vertauscht."],[11.99,13.37,"Mehr braucht es nicht."],[15.27,17.25,"Oder Sie lassen das Werkzeug für sich sprechen."],[21.47,24.18,"Bis zu 17 Werte. Ein Scan."],[30.31,31.63,"Das ist »zidCode«."],[32.13,34.92,"Werkzeugidentifikation direkt an der Maschine."],[37.4,39.02,"Gemessen am Einstellgerät."],[39.47,40.92,"Gescannt an der Maschine."],[41.37,43.26,"Direkt in die Steuerung geschrieben."],[46.35,47.86,"Fast die Hälfte der Zeit."],[50.06,51.77,"Und kein einziger Tippfehler."],[55.41,57.14,"Ganz gleich, welche Steuerung Sie haben."],[62.33,64.36,"Wenn der Auftrag fertig ist: ausscannen."],[64.91,67.48,"Die Standzeit geht direkt zurück in die Cloud."],[67.83,69.29,"Immer aktuell."],[77.35,79.87,"»zidCode«. Jede Ziffer an ihrem Platz."],[82.65,84.79,"ZOLLER. Expect great measures."]],"fr":[[1.5,3.81,"Chaque outil est mesuré au micron près."],[4.91,6.74,"Et ensuite, quelqu’un recopie la valeur."],[9.14,10.99,"Deux chiffres. Inversés."],[11.99,13.37,"Il n’en faut pas plus."